{
  "name": "@mnmal-ai/substrate-sentinel",
  "version": "1.0.0-alpha.2",
  "description": "Substrate coordinator plugin: registry for dynamic bridge discovery.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnmal-ai/substrate.git",
    "directory": "plugins/substrate-sentinel"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./bootstrap": {
      "import": "./dist/bootstrap.js",
      "types": "./dist/bootstrap.d.ts"
    }
  },
  "files": [
    "dist",
    "default-config.json",
    "config.schema.json"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "prepack": "TURBO_TELEMETRY_DISABLED=1 turbo run build --filter=@mnmal-ai/substrate-sentinel",
    "build": "tsdown && tsc -p tsconfig.dts.json",
    "test": "vitest run",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mnmal-ai/substrate": "workspace:*",
    "@mnmal-ai/substrate-config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@mnmal-ai/substrate": ">=1.0.0-alpha.0 <2.0.0"
  },
  "engines": {
    "node": ">=26.2.0"
  },
  "substrate": {
    "tier": "coordinator",
    "entry": "./dist/bootstrap.js",
    "configSchema": "./config.schema.json",
    "defaultConfig": "./default-config.json"
  }
}
