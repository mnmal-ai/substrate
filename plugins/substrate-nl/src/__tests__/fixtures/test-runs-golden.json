  {
    "question": "How many pg-gated tests ran locally 25% slower than on CI in the past 2 days?",
    "expect": {
      "kind": "rows",
      "answer": "count",
      "frame": {
        "runs/Test": {
          "where": {
            "AND": [
              {
                "pgGated": {
                  "eq": true
                }
              },
              {
                "_walk": {
                  "as": "CR",
                  "in": "runs/CiRun.test",
                  "where": {
                    "AND": [
                      {
                        "at": {
                          "gte": "2026-10-28T00:00:00Z",
                          "lt": "2026-10-31T00:00:00Z"
                        }
                      },
                      {
                        "NOT": {
                          "status": {
                            "in": ["skipped", "killed"]
                          }
                        }
                      }
                    ]
                  }
                }
              },
              {
                "_walk": {
                  "as": "LR",
                  "in": "runs/LocalRun.test",
                  "where": {
                    "AND": [
                      {
                        "durationMs": {
                          "gte": {
                            "$ref": "CR.durationMs",
                            "times": 1.25
                          }
                        }
                      },
                      {
                        "NOT": {
                          "status": {
                            "in": ["skipped", "killed"]
                          }
                        }
                      }
                    ]
                  }
                }
              }
            ]
          },
          "count": true
        }
      }
    }
  },
