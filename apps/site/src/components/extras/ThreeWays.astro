---
import { Code } from 'astro:components';
import { EVERY_SURFACE } from '../../../examples/onboard/steps.ts';
import { pageHref } from '../../lib/example-pages.ts';
import { loadExample } from '../../lib/examples.ts';
import { pretty, THEME, threeWays } from '../../lib/steps.ts';

// The onboard run's walk-free read, as HTTP sent it, in the shapes MCP and a subscription take.
const query = loadExample('onboard').transcript?.steps.find((s) => s.label === EVERY_SURFACE);
const ways = query === undefined ? undefined : threeWays(query.body as Record<string, object>);
const panes =
  ways === undefined
    ? []
    : [
        { surface: 'HTTP', how: 'POST /substrate/v1/query', body: ways.http },
        { surface: 'MCP', how: 'the query tool, with arguments', body: ways.mcp },
        { surface: 'Stream', how: 'POST /substrate/v1/subscribe', body: ways.subscribe }
      ];
---
{
  panes.length > 0 && (
    <figure class="ways" aria-labelledby="ways-title">
      <figcaption>
        <h3 id="ways-title">The same frame, three ways</h3>
        <p>
          The walk-free read from the run above, as each surface takes it: the object the run
          sent, unchanged. Only the HTTP run's output is shown here; the{' '}
          <a href={pageHref(import.meta.env.BASE_URL, 'coordinate')}>coordinate example</a> shows a
          live subscription.
        </p>
      </figcaption>
      <div class="panes">
        {panes.map((p) => (
          <div class="pane">
            <p class="label">
              <span class="surface">{p.surface}</span> {p.how}
            </p>
            <Code code={pretty(p.body, 44)} lang="json" theme={THEME} />
          </div>
        ))}
      </div>
    </figure>
  )
}

<style>
  .ways {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
    margin: 20px 0 0;
    padding: clamp(20px, 3vw, 28px);
    border-radius: 14px;
    background: var(--panel-2);
  }

  /* Code panes sit on the darker panel colour inside this lighter box. */
  .ways :global(pre.astro-code) {
    background-color: var(--bg) !important;
  }

  h3 {
    margin: 0;
    font-size: 19px;
  }

  figcaption p {
    max-width: 44em;
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 17px;
  }

  .panes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 16px;
  }

  .pane {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .pane p {
    margin: 0;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .surface {
    color: var(--accent);
  }
</style>
