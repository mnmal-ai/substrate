---
import { loadExample } from '../lib/examples.ts';
import Example from './Example.astro';

// Task 14 brings the ClickBench results in here. Until the file exists the block stays out.
interface ClickBench {
  compared: number;
  total: number;
  sha: string;
  date: string;
  machine: string;
}
const clickbench = Object.values(
  import.meta.glob<ClickBench>('../data/clickbench.json', { eager: true, import: 'default' })
)[0];

// Quote the run's own computed month key.
type Value = { groups?: { month?: string }[] };
const values = (loadExample('warehouse').transcript?.steps ?? []).flatMap((s) =>
  Object.values((s.response as { data?: Record<string, Value> }).data ?? {})
);
const month = values.find((v) => v.groups !== undefined)?.groups?.[0]?.month;
---
<section class="section" aria-labelledby="warehouse-title">
  <div class="joint signal" aria-hidden="true"><span class="pulse"></span></div>
  <p class="label kicker">// warehouse</p>
  <h2 id="warehouse-title">Analytics in the same frames as every read</h2>
  <p class="lede">
    <code>groupBy</code> with <code>dateTrunc</code>, sums and counts, and walks that aggregate
    across a reference. Over the same invoices: what is outstanding by the month it falls due, and
    each customer's open invoices with the next due date.
  </p>
  <p class="lede">
    <code>amount</code> is an <code>int64</code> in integer minor units, cents here. It travels
    as a decimal string so no digit is lost, and sums exactly.
    {
      month !== undefined && (
        <>
          A month key is a computed date, so it comes back as UTC text to the microsecond, as in{' '}
          <code>{month}</code>.
        </>
      )
    }
  </p>
  <div class="run">
    <Example name="warehouse" show={['namespace.ts']} />
  </div>
  {
    clickbench !== undefined && (
      <div class="bench" data-reveal>
        <p class="label kicker">// ClickBench, as frames</p>
        <p class="headline">{`${clickbench.compared} compared / ${clickbench.total}`}</p>
        <p class="label kicker">{`${clickbench.sha} · ${clickbench.date} · ${clickbench.machine}`}</p>
      </div>
    )
  }
</section>

<style>
  .run {
    margin-top: 40px;
  }

  .bench {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 40px;
    padding: 28px;
    border-radius: 14px;
    background: var(--panel);
  }

  .headline {
    margin: 0;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 700;
  }
</style>
