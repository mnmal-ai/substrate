---
import { loadExample } from '../lib/examples.ts';
import Example from './Example.astro';

import { type ClickBench, summarise } from '../lib/clickbench.ts';

// The block stays out until the results file exists.
const clickbench = Object.values(
  import.meta.glob<ClickBench>('../data/clickbench.json', { eager: true, import: 'default' })
)[0];
const sum = clickbench && summarise(clickbench);
const ratios = (clickbench?.passes ?? []).map((p) => p.sumRatio);
const [lo, hi] = [Math.min(...ratios), Math.max(...ratios)];
const vacuous = clickbench?.queries.filter((q) => q.expressible && !q.compared).length ?? 0;

// Quote the run's own computed month key.
type Value = { groups?: { month?: string }[] };
const values = (loadExample('warehouse').transcript?.steps ?? []).flatMap((s) =>
  Object.values((s.response as { data?: Record<string, Value> }).data ?? {})
);
const month = values.find((v) => v.groups !== undefined)?.groups?.[0]?.month;
---
<section class="section" aria-labelledby="warehouse-title">
  <div class="joint signal" aria-hidden="true"><span class="pulse"></span></div>
  <p class="label kicker">// warehouse</p>
  <h2 id="warehouse-title">Analytics in the same frames as every read</h2>
  <p class="lede">
    <code>groupBy</code> with <code>dateTrunc</code>, sums and counts, and walks that aggregate
    across a reference. Over the same invoices: what is outstanding by the month it falls due, and
    each customer's open invoices with the next due date.
  </p>
  <p class="lede">
    <code>amount</code> is an <code>int64</code> in integer minor units, cents here. It travels
    as a decimal string so no digit is lost, and sums exactly.
    {
      month !== undefined && (
        <>
          A month key is a computed date, so it comes back as UTC text to the microsecond, as in{' '}
          <code>{month}</code>.
        </>
      )
    }
  </p>
  <div class="run">
    <Example name="warehouse" show={['namespace.ts']} />
  </div>
  {
    clickbench !== undefined && sum !== undefined && (
      <div class="bench" data-reveal>
        <p class="label kicker">// ClickBench, as frames</p>
        <p class="headline">
          {`${sum.expressible}/${clickbench.queries.length} expressible · ${sum.matched} of ${sum.compared} compared match · ${sum.sumRatio}× hand-written SQL overall (${lo.toFixed(2)}–${hi.toFixed(2)}× across ${clickbench.runs} passes), worst ${sum.worstRatio}×`}
        </p>
        <p class="label kicker">{`${clickbench.sha} · ${clickbench.version} · ${clickbench.date} · ${clickbench.machine} · ${clickbench.runs} runs`}</p>
        <p class="note">
          The same SQL on a plain Postgres table, about 10M rows (every 10th row of the upstream{' '}
          <code>hits</code> file), with answers compared row for row. Times are medians of {clickbench.runs} passes.
          {vacuous > 0 && ` ${vacuous} query came back empty on both sides, so it is not counted as compared.`}
        </p>
      </div>
    )
  }
</section>

<style>
  .run {
    margin-top: 40px;
  }

  .bench {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 40px;
    padding: 28px;
    border-radius: 14px;
    background: var(--panel);
  }

  .headline {
    margin: 0;
    font-size: clamp(22px, 2.6vw, 32px);
    line-height: 1.25;
    font-weight: 700;
  }

  .note {
    margin: 0;
    max-width: 70ch;
  }
</style>
