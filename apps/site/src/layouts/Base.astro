---
import { licensedMonoAvailable } from '../lib/fonts.ts';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/fonts`;
// The prerender chunk is bundled away from src/layouts, so the build's cwd (the package root) anchors this.
const licensed = licensedMonoAvailable(`${process.cwd()}/public`);
const face = (family: string, file: string, weight: string | number) =>
  `@font-face{font-family:'${family}';src:url(${base}/${file}) format('woff2');font-weight:${weight};font-style:normal;font-display:swap}`;
const css = [
  face('DM Sans', 'dm-sans-variable.woff2', '100 1000'),
  face('DM Mono', 'dm-mono-400.woff2', 400),
  face('DM Mono', 'dm-mono-500.woff2', 500),
  ...(licensed
    ? [
        face('Berkeley Mono Site', 'licensed/BerkeleyMono-Regular.woff2', 400),
        face('Berkeley Mono Site', 'licensed/BerkeleyMono-Bold.woff2', 700)
      ]
    : []),
  `:root{--mono:${licensed ? "'Berkeley Mono Site', " : ''}'DM Mono', ui-monospace, monospace}`
].join('');
const preload = licensed
  ? ['licensed/BerkeleyMono-Regular.woff2', 'licensed/BerkeleyMono-Bold.woff2']
  : ['dm-mono-400.woff2'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preload" href={`${base}/dm-sans-variable.woff2`} as="font" type="font/woff2" crossorigin />
    {preload.map((f) => <link rel="preload" href={`${base}/${f}`} as="font" type="font/woff2" crossorigin />)}
    <style set:html={css}></style>
  </head>
  <body>
    <slot />
  </body>
</html>
