    {
      "label": "collections-agent receives it, live",
      "method": "POST",
      "path": "/substrate/v1/subscribe",
      "as": "collections-agent",
      "feed": true,
      "receive": "open-tasks",
      "status": 200,
      "response": {
        "id": "frames-subscribe",
        "kind": "add",
        "schemaVersion": "07bfc81ece17",
        "data": {
          "app/Task": {
            "id": "0197a000-0000-7000-8000-000000000012",
            "title": "Chase Lumen Works for INV-1002",
            "invoice": "0197a000-0000-7000-8000-000000000005",
            "status": "open"
          }
        },
        "shapes": {
          "app/Task": "single"
        }
      }
    },
    {
      "label": "collections-agent reads it, with the key that signed it",
      "method": "POST",
      "path": "/substrate/v1/query",
      "body": {
        "app/Task": {
          "params": {
            "where": {
              "id": {
                "eq": "0197a000-0000-7000-8000-000000000012"
              }
            }
          },
          "fields": {
            "title": true,
            "status": true,
            "forInvoice": {
              "_walk": {
                "out": "invoice"
              },
              "fields": {
                "number": true,
                "dueAt": true
              }
            },
            "_metadata": {
              "createdBy": true
            }
          }
        }
      },
      "as": "collections-agent",
      "feed": false,
      "status": 200,
      "response": {
        "schemaVersion": "07bfc81ece17",
        "data": {
          "app/Task": [
            {
              "title": "Chase Lumen Works for INV-1002",
              "status": "open",
              "forInvoice": [
                {
                  "id": "0197a000-0000-7000-8000-000000000005",
                  "number": "INV-1002",
                  "dueAt": "2026-09-18T00:00:00.000Z"
                }
              ],
              "_metadata": {
                "createdBy": {
                  "kind": "user",
                  "id": "billing-agent"
                }
              }
            }
          ]
        },
        "shapes": {
          "app/Task": "list"
        },
        "_pagination": {
          "app/Task": {
            "hasMore": false
          }
        }
      }
    },
    {
      "label": "collections-agent takes it",
      "method": "POST",
      "path": "/substrate/v1/mutate",
      "body": {
        "app/updateTask": {
          "params": {
            "id": "0197a000-0000-7000-8000-000000000012",
            "status": "in_progress"
          },
          "fields": {
            "id": true,
            "status": true,
