{
  "example": "coordinate",
  "steps": [
    {
      "label": "collections-agent subscribes to open tasks",
      "method": "POST",
      "path": "/substrate/v1/subscribe",
      "body": {
        "app/Task": {
          "params": {
            "where": {
              "status": {
                "eq": "open"
              }
            }
          },
          "fields": {
            "id": true,
            "title": true,
            "invoice": true,
            "status": true
          }
        }
      },
      "as": "collections-agent",
      "feed": false,
      "stream": "open-tasks",
      "status": 200,
      "response": {
        "id": "frames-subscribe",
        "kind": "snapshot",
        "schemaVersion": "07bfc81ece17",
        "data": {
          "app/Task": []
        },
        "shapes": {
          "app/Task": "list"
        }
      }
    },
