    {
      "label": "billing-agent opens a task: INV-1002 was due 18 Sep and today is 3 Nov 2026",
      "method": "POST",
      "path": "/substrate/v1/mutate",
      "body": {
        "app/createTask": {
          "params": {
            "id": "0197a000-0000-7000-8000-000000000012",
            "title": "Chase Lumen Works for INV-1002",
            "invoice": "0197a000-0000-7000-8000-000000000005",
            "status": "open"
          },
          "fields": {
            "id": true,
            "title": true,
            "status": true
          }
        }
      },
      "as": "billing-agent",
      "feed": true,
      "status": 200,
      "response": {
