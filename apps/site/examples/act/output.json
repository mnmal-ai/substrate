    {
      "label": "collections-agent opens a task to chase INV-1002",
      "method": "POST",
      "path": "/substrate/v1/act",
      "body": {
        "sketch": "create Task title=\"Chase Lumen Works for INV-1002\" invoice=#2 status=open"
      },
      "as": "collections-agent",
      "feed": false,
      "status": 200,
      "response": {
        "ok": true,
        "ack": "created app/Task #1",
        "result": "r_1"
      }
    },
    {
      "label": "It asks what an Invoice can do",
      "method": "POST",
      "path": "/substrate/v1/act",
      "body": {
        "sketch": "? Invoice"
      },
      "as": "collections-agent",
      "feed": false,
      "status": 200,
      "response": {
        "ok": true,
        "help": {
          "type": "app/Invoice",
          "actions": {
            "pay": {
              "kind": "update",
              "params": {
                "closes": {
                  "type": "→app/Task[]",
                  "required": false
                }
              }
            },
            "void": {
              "kind": "update",
              "params": {}
            }
          },
          "fields": {
            "number": {
              "type": "string",
              "required": true
            },
            "amount": {
              "type": "int64",
              "required": true
            },
            "currency": {
              "type": "string",
              "required": true
            },
            "issuedAt": {
              "type": "date",
              "required": true
            },
            "dueAt": {
              "type": "date",
              "required": true
            },
            "status": {
              "type": "draft|sent|paid|void",
              "required": true
            },
            "customer": {
              "type": "→app/Customer",
              "required": false
            },
            "shortId": {
              "type": "number [readonly]",
              "required": false
            }
          }
        }
      }
    },
    {
      "label": "The payment lands: pay INV-1002 and close the task, in one transaction",
      "method": "POST",
      "path": "/substrate/v1/act",
      "body": {
        "sketch": "pay Invoice #2 closes=#1"
      },
      "as": "collections-agent",
      "feed": false,
      "status": 200,
      "response": {
        "ok": true,
        "ack": "paid app/Invoice #2; closed app/Task #1",
        "result": "r_2"
      }
    },
    {
      "label": "A typo is refused with the nearest valid sketch, and nothing runs",
      "method": "POST",
      "path": "/substrate/v1/act",
      "body": {
        "sketch": "pay Invoce #3"
      },
      "as": "collections-agent",
      "feed": false,
      "status": 200,
      "response": {
        "ok": false,
        "refusal": {
          "code": "sketch_unresolved",
          "step": 1,
          "token": "Invoce",
          "problem": "unknown type 'Invoce'",
          "choices": [
            "Customer",
            "Invoice",
            "Task"
          ],
          "nearest": "pay Invoice #3"
        }
      }
    },
    {
      "label": "The rows it touched, read back with the key that wrote them",
      "method": "POST",
      "path": "/substrate/v1/query",
      "body": {
        "app/Invoice": {
          "params": {
            "where": {
              "number": {
                "eq": "INV-1002"
              }
            }
          },
          "fields": {
            "number": true,
            "status": true,
            "_metadata": {
              "updatedBy": true
            }
          }
        },
        "app/Task": {
          "params": {},
          "fields": {
            "title": true,
            "status": true,
            "_metadata": {
              "updatedBy": true
            }
          }
        }
      },
      "as": "collections-agent",
      "feed": false,
      "status": 200,
      "response": {
        "schemaVersion": "schema",
        "data": {
          "app/Task": [
            {
              "title": "Chase Lumen Works for INV-1002",
              "status": "done",
              "_metadata": {
                "updatedBy": {
                  "kind": "agent",
                  "id": "collections-agent"
                }
              }
            }
          ],
          "app/Invoice": [
            {
              "number": "INV-1002",
              "status": "paid",
              "_metadata": {
                "updatedBy": {
                  "kind": "agent",
                  "id": "collections-agent"
                }
              }
            }
          ]
        },
        "shapes": {
          "app/Task": "list",
          "app/Invoice": "list"
        },
        "_pagination": {
          "app/Task": {
            "hasMore": false
          },
          "app/Invoice": {
            "hasMore": false
          }
        }
      }
    }
  ]
}
