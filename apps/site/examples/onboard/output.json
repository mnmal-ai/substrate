    {
      "label": "Query sent invoices, with the customer",
      "method": "POST",
      "path": "/substrate/v1/query",
      "body": {
        "app/Invoice": {
          "params": {
            "where": {
              "status": {
                "eq": "sent"
              }
            },
            "orderBy": [
              {
                "dueAt": "asc"
              }
            ]
          },
          "fields": {
            "number": true,
            "amount": true,
            "currency": true,
            "dueAt": true,
            "billedTo": {
              "_walk": {
                "out": "customer"
              },
              "fields": {
                "name": true
              }
            }
          }
        }
      },
      "feed": true,
      "status": 200,
      "response": {
        "schemaVersion": "9a75ac1bfcbb",
        "data": {
          "app/Invoice": [
            {
              "number": "INV-1002",
              "amount": "84050",
              "currency": "EUR",
              "dueAt": "2026-09-18T00:00:00.000Z",
              "billedTo": [
                {
                  "id": "0197a000-0000-7000-8000-000000000002",
                  "name": "Lumen Works"
                }
              ]
            },
