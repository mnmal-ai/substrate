    {
      "label": "Ask the server to describe itself",
      "method": "GET",
      "path": "/substrate/v1/onboard",
      "feed": false,
      "status": 200,
      "response": {
        "binary": {
          "coordinators": [
            {
              "name": "onboard",
              "namespaces": [
                "app"
              ]
            }
          ]
        },
        "frameGrammar": {
          "queryKey": "<ns>/<TypeName>",
          "mutationKey": "<ns>/<mutationName>"
        }
      }
    },
    {
      "label": "Read the app schema, with its generated mutations",
      "method": "GET",
      "path": "/substrate/v1/schema/app",
      "feed": false,
      "status": 200,
      "response": {
        "types": {
          "Customer": {
            "fields": {
              "name": {
                "kind": "scalar",
                "type": "string"
              },
              "email": {
                "kind": "scalar",
                "type": "string"
              },
              "region": {
                "kind": "scalar",
                "type": "string"
              },
              "shortId": {
                "kind": "scalar",
                "type": "number",
                "indexed": true,
                "readonly": true
              }
            },
            "inboundRefs": [
              {
                "type": "Invoice",
                "field": "customer"
              }
            ]
          },
          "Invoice": {
            "fields": {
              "number": {
                "kind": "scalar",
                "type": "string"
              },
              "amount": {
                "kind": "scalar",
                "type": "int64"
              },
              "currency": {
                "kind": "scalar",
                "type": "string"
              },
              "issuedAt": {
                "kind": "scalar",
                "type": "date"
              },
              "dueAt": {
                "kind": "scalar",
                "type": "date"
              },
              "status": {
                "kind": "scalar",
                "type": "string",
                "enum": [
                  "draft",
                  "sent",
                  "paid",
                  "void"
                ]
              },
              "customer": {
                "kind": "crossRef",
                "ns": "app",
                "type": "Customer",
                "onDelete": "set_null",
                "indexed": true
              },
              "shortId": {
                "kind": "scalar",
                "type": "number",
                "indexed": true,
                "readonly": true
              }
            }
          }
        },
        "mutations": [
          "getCustomer",
          "createCustomer",
          "updateCustomer",
          "deleteCustomer",
          "updateManyCustomer",
          "deleteManyCustomer",
          "getInvoice",
          "createInvoice",
          "updateInvoice",
          "deleteInvoice",
          "updateManyInvoice",
          "deleteManyInvoice"
        ]
      }
    }
