    {
      "label": "Unpaid invoices by month due",
      "method": "POST",
      "path": "/substrate/v1/query",
      "body": {
        "app/Invoice": {
          "params": {
            "where": {
              "status": {
                "eq": "sent"
              }
            },
            "aggregate": {
              "outstanding": {
                "sum": "amount"
              },
              "invoices": {
                "count": true
              }
            },
            "groupBy": {
              "month": {
                "dateTrunc": [
                  {
                    "lit": "month"
                  },
                  "dueAt"
                ]
              }
            },
            "orderBy": [
              {
                "month": "asc"
              }
            ]
          },
          "fields": {
            "id": true
          }
        }
      },
      "feed": true,
      "status": 200,
      "response": {
        "schemaVersion": "9a75ac1bfcbb",
        "data": {
          "app/Invoice": {
            "groups": [
              {
                "month": "2026-09-01T00:00:00.000000Z",
                "outstanding": "84050",
                "invoices": 1
              },
              {
                "month": "2026-10-01T00:00:00.000000Z",
                "outstanding": "230000",
                "invoices": 1
              },
              {
                "month": "2026-11-01T00:00:00.000000Z",
                "outstanding": "336400",
                "invoices": 3
              }
            ]
          }
        },
        "shapes": {
          "app/Invoice": "groups"
        }
      }
    },
    {
      "label": "Open invoices and next due date per customer",
      "method": "POST",
      "path": "/substrate/v1/query",
      "body": {
        "app/Customer": {
          "params": {
            "orderBy": [
              {
                "name": "asc"
              }
            ]
          },
          "fields": {
            "name": true,
            "region": true,
            "_agg": {
              "open": {
                "in": "app/Invoice.customer",
                "where": {
                  "status": {
                    "eq": "sent"
                  }
                },
                "count": true
              },
              "nextDue": {
                "in": "app/Invoice.customer",
                "where": {
                  "status": {
                    "eq": "sent"
                  }
                },
                "min": "dueAt"
              }
            }
          }
        }
      },
      "feed": true,
      "status": 200,
      "response": {
        "schemaVersion": "9a75ac1bfcbb",
        "data": {
          "app/Customer": [
            {
              "name": "Harbor & Pine",
              "region": "EMEA",
              "_agg": {
                "open": 1,
                "nextDue": "2026-11-27T00:00:00.000Z"
              }
            },
            {
              "name": "Lumen Works",
              "region": "NA",
              "_agg": {
                "open": 2,
                "nextDue": "2026-09-18T00:00:00.000Z"
              }
            },
            {
              "name": "Tidewater Labs",
              "region": "APAC",
              "_agg": {
                "open": 2,
                "nextDue": "2026-10-02T00:00:00.000Z"
              }
            }
          ]
        },
        "shapes": {
          "app/Customer": "list"
        },
        "_pagination": {
          "app/Customer": {
            "hasMore": false
          }
        }
      }
    }
