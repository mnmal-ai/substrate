    {
      "label": "Propose billing/Payment, with a reference to app/Invoice",
      "method": "POST",
      "path": "/substrate/v1/mutate",
      "body": {
        "billing/propose_type": {
          "params": {
            "typeName": "Payment",
            "fields": {
              "amount": {
                "kind": "scalar",
                "type": "int64"
              },
              "paidAt": {
                "kind": "scalar",
                "type": "date"
              },
              "invoice": {
                "kind": "crossRef",
                "ns": "app",
                "type": "Invoice"
              }
            },
            "proposedReason": "Record the payments that settle invoices"
          },
          "fields": {
            "id": true
          }
        }
      },
      "as": "schema-agent",
      "feed": true,
      "status": 200,
      "response": {
        "schemaVersion": "3d6fa5b71fd0",
        "data": {
          "billing/propose_type": {
            "id": "0197a000-0000-7000-8000-000000000012"
          }
        },
        "shapes": {
          "billing/propose_type": "single"
        }
      }
    },
    {
      "label": "Record a payment against INV-1002, on the next call",
      "method": "POST",
      "path": "/substrate/v1/mutate",
      "body": {
        "billing/createPayment": {
          "params": {
            "id": "0197a000-0000-7000-8000-000000000013",
            "amount": 84050,
            "paidAt": "2026-11-03T00:00:00.000Z",
            "invoice": "0197a000-0000-7000-8000-000000000005"
          },
          "fields": {
            "id": true,
            "amount": true,
            "paidAt": true
          }
        }
      },
      "as": "schema-agent",
      "feed": false,
      "status": 200,
      "response": {
        "schemaVersion": "f18c083dcbdd",
        "data": {
          "billing/createPayment": {
            "id": "0197a000-0000-7000-8000-000000000013",
            "amount": "84050",
            "paidAt": "2026-11-03T00:00:00.000Z"
          }
        },
        "shapes": {
          "billing/createPayment": "single"
        }
      }
    },
    {
      "label": "Read payments, walking out to the invoice",
      "method": "POST",
      "path": "/substrate/v1/query",
      "body": {
        "billing/Payment": {
          "fields": {
            "id": true,
            "amount": true,
            "paidAt": true,
            "settles": {
              "_walk": {
                "out": "invoice"
              },
              "fields": {
                "number": true,
                "status": true
              }
            }
          }
        }
      },
      "as": "schema-agent",
      "feed": true,
      "status": 200,
      "response": {
        "schemaVersion": "b4983beec45b",
        "data": {
          "billing/Payment": [
            {
              "id": "0197a000-0000-7000-8000-000000000013",
              "amount": "84050",
              "paidAt": "2026-11-03T00:00:00.000Z",
              "settles": [
                {
                  "id": "0197a000-0000-7000-8000-000000000005",
                  "number": "INV-1002",
                  "status": "sent"
                }
              ]
            }
          ]
        },
        "shapes": {
          "billing/Payment": "list"
        },
        "_pagination": {
          "billing/Payment": {
            "hasMore": false
          }
        }
      }
    },
    {
      "label": "Read the proposal record: proposedBy is stamped by the server",
      "method": "POST",
      "path": "/substrate/v1/query",
      "body": {
        "billing/TypeProposal": {
          "params": {
            "where": {
              "typeName": {
                "eq": "Payment"
              }
            }
          },
          "fields": {
            "id": true,
            "typeName": true,
            "applied": true,
            "proposedBy": true,
            "proposedReason": true
          }
        }
      },
      "as": "schema-agent",
      "feed": false,
      "status": 200,
      "response": {
        "schemaVersion": "f18c083dcbdd",
        "data": {
          "billing/TypeProposal": [
            {
              "id": "0197a000-0000-7000-8000-000000000012",
              "typeName": "Payment",
              "applied": true,
              "proposedBy": "schema-agent",
              "proposedReason": "Record the payments that settle invoices"
            }
          ]
        },
        "shapes": {
          "billing/TypeProposal": "list"
        },
        "_pagination": {
          "billing/TypeProposal": {
            "hasMore": false
          }
        }
      }
    }
  ]
