{
  "name": "@mnmal-ai/substrate-workspace",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "TURBO_TELEMETRY_DISABLED=1 turbo run build",
    "dev": "turbo run dev",
    "lint": "TURBO_TELEMETRY_DISABLED=1 turbo run lint --continue",
    "format": "biome format --write .",
    "check-types": "TURBO_TELEMETRY_DISABLED=1 turbo run check-types",
    "test": "TURBO_TELEMETRY_DISABLED=1 turbo run test --continue",
    "concepts:snapshot": "node scripts/concepts-snapshot.js"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@mnmal-ai/substrate-dataset-pg": "workspace:*",
    "@mnmal-ai/substrate-embedder": "workspace:*",
    "@mnmal-ai/substrate-policy": "workspace:*",
    "oxc-parser": "catalog:",
    "postgres": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.2.0"
  }
}
