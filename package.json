{
  "name": "@mnmal-ai/substrate-workspace",
  "private": true,
  "description": "Workspace root for Substrate.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnmal-ai/substrate.git"
  },
  "type": "module",
  "scripts": {
    "build": "TURBO_TELEMETRY_DISABLED=1 turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "check-types": "TURBO_TELEMETRY_DISABLED=1 turbo run check-types",
    "test": "TURBO_TELEMETRY_DISABLED=1 turbo run test --continue",
    "concepts:snapshot": "node scripts/concepts-snapshot.js"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@mnmal-ai/substrate-dataset-pg": "workspace:*",
    "@mnmal-ai/substrate-embedder": "workspace:*",
    "@mnmal-ai/substrate-policy": "workspace:*",
    "oxc-parser": "catalog:",
    "postgres": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.12.1"
  }
}
