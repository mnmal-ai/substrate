{
  "name": "@mnmal-ai/substrate-compose",
  "version": "1.0.0-alpha.9",
  "private": true,
  "description": "Compose plugins, datasets, and a server into a runnable Substrate engine.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnmal-ai/substrate.git",
    "directory": "packages/substrate-compose"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.dts.json",
    "test": "vitest run --passWithNoTests",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "@mnmal-ai/substrate-bootstrap": "workspace:*",
    "@mnmal-ai/substrate-core": "workspace:*",
    "@mnmal-ai/substrate-dataset-memory": "workspace:*",
    "@mnmal-ai/substrate-pack": "workspace:*",
    "@mnmal-ai/substrate-policy": "workspace:*",
    "@mnmal-ai/substrate-sdk": "workspace:*",
    "@mnmal-ai/substrate-types": "workspace:*",
    "semver": "catalog:"
  },
  "devDependencies": {
    "@mnmal-ai/substrate-config": "workspace:*",
    "@mnmal-ai/substrate-server-fastify": "workspace:*",
    "@mnmal-ai/substrate-server-memory": "workspace:*",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "@types/ws": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=26.12.1"
  }
}
