{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2025"],
    "types": ["node"],
    // Same source-resolution map as tsconfig.lib.json — apps now resolve
    // workspace imports to package SOURCE, killing the transient TS7016
    // "could not find declaration file for .../dist/index.js" noise that fires
    // while the bundler rebuilds a dependency's dist. Paths are relative to THIS file
    // (TS >=5.0 resolves `paths` in `extends` relative to the declaring
    // config). The one exception is substrate-client, the lone DOM-lib package
    // (transport/ws.ts names `BinaryType`); it is back in the workspace, so a
    // consumer app that resolves it to source fails this ES2025-only lib.
    // Such an app (apps/substrate, for `substrate ask`) overrides `paths` in its own
    // tsconfig to point `@mnmal-ai/substrate-client` at its built dist/index.d.ts.
    "paths": {
      "@mnmal-ai/substrate/*": ["../../apps/substrate/src/exports/*.ts"],
      "@mnmal-ai/*": ["../*/src/index.ts", "../../plugins/*/src/index.ts"]
    }
  }
}
